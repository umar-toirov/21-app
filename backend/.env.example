# Copy to .env and fill in values. Never commit .env.

# --- Database ---
# Local (default for design work on this PC):
DATABASE_URL=sqlite+aiosqlite:///./ilmmode.db

# Supabase Postgres (Phase 1 — cloud data storage):
# Dashboard → Project Settings → Database → Connection string → URI
# Use the "URI" and change scheme to postgresql+asyncpg://  OR paste postgresql://
# (the app auto-upgrades postgres:// and postgresql:// to +asyncpg)
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Direct (non-pooler) also works:
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR_DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# --- Supabase Auth (already used by FastAPI JWT verify + Flutter) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-settings
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
ENVIRONMENT=development
# production | development — production forces SSL for Postgres and quieter SQL logs
CORS_ORIGINS=http://127.0.0.1:8090,http://localhost:8090,http://127.0.0.1:3000,http://localhost:3000
INTERNAL_JOB_SECRET=change-me-in-production
CHALLENGE_PRICE_UZS=99000
